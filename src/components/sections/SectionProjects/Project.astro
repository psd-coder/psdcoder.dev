---
import type { CollectionEntry } from "astro:content";
import type { SvgComponent } from "astro/types";
import { Card } from "~/components/ui/Card";
import styles from "./styles.module.css";

type Props = {
  project: CollectionEntry<"projects">;
};

const logos = import.meta.glob<{ default: SvgComponent }>("../../../assets/projects/*.svg");

const { project } = Astro.props;
const { name, description, role, tags, href, logo } = project.data;

let Logo: SvgComponent | undefined;
if (logo) {
  const loadLogo = logos[`../../../assets/${logo}`];
  if (!loadLogo) throw new Error(`Project logo not found: ${logo}`);
  Logo = (await loadLogo()).default;
}
---

<li>
  <Card class:list={[styles.project, !logo && styles.noLogo]}>
    {Logo && <Logo class={styles.logo} width="44" height="44" aria-hidden="true" />}
    <span class={styles.content}>
      <span class={styles.heading}>
        <h3 class={styles.title}>
          <a class={styles.titleLink} href={href}>{name}</a>
        </h3>
        {role && <span class={styles.role}>{role}</span>}
      </span>
      <p class={styles.description}>{description}</p>
    </span>
    <span class={styles.tags}>
      {tags.join(" / ")}
    </span>
  </Card>
</li>
