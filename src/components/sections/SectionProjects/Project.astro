---
import type { CollectionEntry } from "astro:content";
import type { SvgComponent } from "astro/types";
import { Card } from "~/components/ui/Card";
import styles from "./styles.module.css";

type Props = {
  project: CollectionEntry<"projects">;
};

const logos = import.meta.glob<{ default: SvgComponent }>("../../../assets/projects/*.svg");

const { project } = Astro.props;
const { name, description, role, tags, href, logo } = project.data;
const loadLogo = logos[`../../../assets/${logo}`];
if (!loadLogo) throw new Error(`Project logo not found: ${logo}`);
const { default: Logo } = await loadLogo();
---

<li>
  <Card as="a" class={styles.project} href={href}>
    <Logo class={styles.logo} width="44" height="44" aria-hidden="true" />
    <span class={styles.content}>
      <h3 class={styles.title}>
        {name}
        {role && <span class={styles.role}>{role}</span>}
      </h3>
      <p class={styles.description}>{description}</p>
    </span>
    <span class={styles.tags}>
      {tags.join(" / ")}
    </span>
  </Card>
</li>
